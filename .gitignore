# ---- 构建产物（用 GitHub Releases 发布 setup.exe，不进仓库）----
setupEXE/
*.blockmap

# ---- 依赖（npm install 可恢复）----
node_modules/

# ---- 早期启动器残留：完整 LX Electron 运行时，深度集成后已不使用 ----
bundled/

# ---- 洛雪源码克隆（仅移植参考，上游: https://github.com/lyswhut/lx-music-desktop）----
_lx-source/
_lx-build/

# ---- AnnieEngine 二进制（由 AnnieEngine 引擎项目构建产出，构建前放入 engine/）----
engine/publish/
# engine/tools 不入库（ffmpeg 体积大，由 npm run setup:tools 下载），但 sacd_extract 小工具入库保证 CI/新机器可用
engine/tools/*
!engine/tools/sacd_extract.exe
!engine/tools/sacd_extract.cfg

# ---- AnnieEngine 源码构建产物（源码本身入库，见 engine/src/）----
engine/src/bin/
engine/src/obj/
engine/src/publish/

# ---- 构建日志/临时文件 ----
build-err.txt
build-out.txt
better-sqlite3.tar.gz
*.log

# ---- 测试报告（本地产出，不入库）----
长稳测试报告*.md
曲库Benchmark报告*.md
soak-*.md

# ---- 便携模式数据 ----
portable/

# ---- 系统文件 ----
Thumbs.db
.DS_Store

# ---- 开发工具工作目录 ----
.omo/

# ---- 引擎 junction（开发态镜像，指向 engine/）----
annie/engine/

# ---- VST 实验区（施工副本，成果已并入主工程，副本本身不入库）----
VST实验区/

# ---- am.js 拆分隔离工作区（原稿副本与切分/校验脚本，不入库）----
amchaifenwork/
