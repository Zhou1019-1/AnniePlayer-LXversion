<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>AnnieEngine</AssemblyName>
    <RootNamespace>MineEngine</RootNamespace>
    <Version>1.0.0</Version>
    <Description>安妮播放器独占音频引擎 AnnieEngine：WASAPI Exclusive / ASIO 输出，FFmpeg 解码，JSON-RPC(stdio) 控制。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Asio" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

</Project>
